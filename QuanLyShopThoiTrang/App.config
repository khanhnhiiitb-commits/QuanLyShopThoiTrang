<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=5.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<connectionStrings>
		<add name="ShopThoiTrangEntities"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=TÊN_DATABASE_CỦA_BẠN_ĐIỀN_VÀO_ĐÂY;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<entityFramework>
		<defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
			<parameters>
				<parameter value="v15.0" />
			</parameters>
		</defaultConnectionFactory>
	</entityFramework>
</configuration>